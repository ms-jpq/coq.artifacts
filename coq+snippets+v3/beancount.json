{
  "extends": [],
  "snippets": [
    {
      "content": "option \"${1:name}\" \"${2:value}\"\n$0",
      "doc": "Add option.",
      "label": "option",
      "matches": {
        "option": true
      }
    },
    {
      "content": "${1:$CURRENT_YEAR}-${2:$CURRENT_MONTH}-${3:$CURRENT_DATE} event \"${4:Key}\" \"${5:Value}\"\n$0",
      "doc": "Add a dated event/variable to track.",
      "label": "event",
      "matches": {
        "event": true
      }
    },
    {
      "content": "${1:$CURRENT_YEAR}-${2:$CURRENT_MONTH}-${3:$CURRENT_DATE} commodity ${4:ISO/Ticker}\n  name: \"${5:FullName}\"\n  asset-class: \"${6|cash,stock|}\"\n$0",
      "doc": "Add a commodity metadata (optional).",
      "label": "commoditiy directive",
      "matches": {
        "commodity": true
      }
    },
    {
      "content": "plugin \"${4:PluginName}\" \"${5:ConfigString}\"\n$0",
      "doc": "Load a plugin.",
      "label": "plugin",
      "matches": {
        "plugin": true
      }
    },
    {
      "content": "${1:$CURRENT_YEAR}-${2:$CURRENT_MONTH}-${3:$CURRENT_DATE} custom \"${4:TypeName}\" ${5:Value...}\n$0",
      "doc": "Add a custom directive.",
      "label": "custom",
      "matches": {
        "custom": true
      }
    },
    {
      "content": "${1:$CURRENT_YEAR}-${2:$CURRENT_MONTH}-${3:$CURRENT_DATE} * \"${4:Payee}\" \"${5:Narration}\"\n  $0",
