      "content": "${1:$CURRENT_YEAR}-${2:$CURRENT_MONTH}-${3:$CURRENT_DATE} custom \"budget\" ${5:Expenses:} \"${6|daily,weekly,monthly,quaterly,yearly|}\" ${7:Amount}\n$0",
      "doc": "Add a Fava compatible budget directive.",
      "label": "budget",
      "matches": {
        "budget": true
      }
