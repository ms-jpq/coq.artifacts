      "doc": "Open an account.",
      "label": "open directive",
      "matches": {
        "open": true
      }
    },
    {
      "content": "include \"${4:Filename}\"\n$0",
      "doc": "Include a beancount file.",
      "label": "include",
      "matches": {
        "include": true
      }
