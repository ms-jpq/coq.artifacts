  "snippets": [
    {
      "content": "Blade::include('${1:includes.input}', '${2:input}');",
      "doc": "Aliasing Includes (AppServiceProvider boot method)",
      "label": "Blade-include",
      "matches": {
        "Blade::include": true
      }
    },
