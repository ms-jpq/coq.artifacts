      "label": "Unreal SpawnActorDeferred",
      "matches": {
        "uspawn_actor_deferred": true
      }
    },
    {
      "content": "UE_LOG(LogTemp, ${1|Display,Warning,Error,Fatal|}, TEXT(\"$2%s\"), ANSI_TO_TCHAR(__FUNCTION__));",
      "doc": "Write a message to the log",
      "label": "Write to Log (with fn helper)",
      "matches": {
        "ulogfn": true
      }
    }
  ]
